# Generá un valor aleatorio para cada instalación local.
AUTH_SECRET=replace-with-a-random-secret
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Configurá un servidor SMTP para habilitar la recuperación por email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Activá esto solo detrás de un proxy que elimine cabeceras IP enviadas por clientes.
TRUST_PROXY=false
